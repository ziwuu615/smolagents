# 复制本文件为 .env，并填入真实的 Key。二选一即可，推荐 DeepSeek。

# DeepSeek（国内可直连，便宜，推荐）
# 获取地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 阿里云通义千问（备选，OpenAI 兼容接口）
# 获取地址：https://dashscope.console.aliyun.com/
QWEN_API_KEY=
QWEN_MODEL=qwen-plus

# GitHub（github_mcp_server.py 用，均可不填）
# 不填 token 用匿名额度 60 次/小时，够 demo；填了升到 5000 次/小时
# 获取地址：https://github.com/settings/tokens （勾选 public_repo 只读权限即可）
GITHUB_TOKEN=
# 访问 GitHub API 需走本机代理（否则被墙重置）
GITHUB_PROXY=http://127.0.0.1:7897
